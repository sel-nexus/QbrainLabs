# ===========================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# ===========================================

# Environment
NODE_ENV=development
ENVIRONMENT=development
DEBUG=true

# Application
PROJECT_NAME=Hotspot Matrix
API_V1_STR=/api/v1

# Server
HOST=127.0.0.1
PORT=8000

# Database (SQLite for development)
DATABASE_URL=postgresql://postgres.ngizbskgujghosbyguqw:mCPLxdcjY0W2PlwT@aws-1-us-east-1.pooler.supabase.com:6543/postgres


# Redis (Optional for local dev)
REDIS_URL=redis://localhost:6379/0

# Security (Development keys - DO NOT use in production)
SECRET_KEY=dev-secret-key-change-in-production-minimum-32-chars
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# CORS (Development origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# Rate Limiting (Relaxed for development)
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60

# AI Integration (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_WEBSOCKETS=true
ENABLE_METRICS=true
