# ===========================================
# HOTSPOT MATRIX ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env files with real secrets to version control

# -------------------------------------------
# ENVIRONMENT
# -------------------------------------------
# Options: development, testing, production
NODE_ENV=development
ENVIRONMENT=development
DEBUG=true

# -------------------------------------------
# APPLICATION
# -------------------------------------------
PROJECT_NAME=Hotspot Matrix
API_V1_STR=/api/v1

# -------------------------------------------
# SERVER
# -------------------------------------------
HOST=127.0.0.1
PORT=8000
# Workers (for production with Gunicorn/Uvicorn)
WORKERS=4

# -------------------------------------------
# DATABASE
# -------------------------------------------
# PostgreSQL (Default - recommended for all environments)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotspotmatrix

# SQLite (Testing only - not recommended for production)
# DATABASE_URL=sqlite:///./hotspotmatrix.db

# Connection Pool Settings (PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# -------------------------------------------
# REDIS (Optional)
# -------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# -------------------------------------------
# SECURITY
# -------------------------------------------
# IMPORTANT: Generate secure random strings for production!
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_SECRET_KEY=CHANGE_ME_TO_ANOTHER_SECURE_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------
# CORS
# -------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -------------------------------------------
# LOGGING
# -------------------------------------------
# Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Format: text, json
LOG_FORMAT=text
# Optional log file path
LOG_FILE=

# -------------------------------------------
# MONITORING (Optional)
# -------------------------------------------
# Sentry DSN for error tracking
SENTRY_DSN=
# Enable Prometheus metrics endpoint
PROMETHEUS_ENABLED=true

# -------------------------------------------
# AI INTEGRATION (Optional)
# -------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# -------------------------------------------
# RATE LIMITING
# -------------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# -------------------------------------------
# FILE UPLOAD
# -------------------------------------------
# Max upload size in bytes (default: 10MB)
MAX_UPLOAD_SIZE=10485760

# -------------------------------------------
# FEATURE FLAGS
# -------------------------------------------
ENABLE_AI_FEATURES=true
ENABLE_WEBSOCKETS=true
ENABLE_METRICS=true
