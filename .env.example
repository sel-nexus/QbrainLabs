# ===========================================
# QBRAIN AI LABS ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your values
# This is the consolidated .env file for both server and client
# NEVER commit .env files with real secrets to version control

# -------------------------------------------
# ENVIRONMENT
# -------------------------------------------
# Options: development, testing, production
NODE_ENV=development
ENVIRONMENT=development
DEBUG=true

# -------------------------------------------
# APPLICATION
# -------------------------------------------
PROJECT_NAME=Qbrain AI Labs
API_V1_STR=/api/v1

# -------------------------------------------
# SERVER (Backend)
# -------------------------------------------
HOST=127.0.0.1
PORT=8000
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# Workers (for production with Gunicorn/Uvicorn)
WORKERS=4

# -------------------------------------------
# CLIENT (Frontend - Vite)
# -------------------------------------------
# Note: Only VITE_* prefixed variables are exposed to the client
# Use 0.0.0.0 to allow access from network IP addresses, localhost for local-only access
CLIENT_HOST=0.0.0.0
CLIENT_PORT=5173
VITE_AUTH_DOMAIN=your-auth0-domain
VITE_AUTH_CLIENT_ID=your-client-id
# VITE_API_URL=http://... (Optional override for API endpoint)

# -------------------------------------------
# DATABASE
# -------------------------------------------
# PostgreSQL (Default - recommended for all environments)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotspotmatrix

# SQLite (Testing only - not recommended for production)
# DATABASE_URL=sqlite:///./hotspotmatrix.db

# Connection Pool Settings (PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# -------------------------------------------
# REDIS (Optional)
# -------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# -------------------------------------------
# SECURITY
# -------------------------------------------
# IMPORTANT: Generate secure random strings for production!
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_SECRET_KEY=CHANGE_ME_TO_ANOTHER_SECURE_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------
# CORS
# -------------------------------------------
# Dynamic CORS is enabled by default (ENABLE_DYNAMIC_CORS=true)
# This automatically accepts origins matching server IP addresses (both private and public IPs)
# The application will work when accessed via either private IP (e.g., 172.31.33.5) or public IP (e.g., 18.191.118.132)
#
# Comma-separated list of additional allowed origins (used in addition to dynamic IP-based origins)
# Add custom domains or specific IPs here if needed
# Examples:
#   - Custom domain: http://example.com:5173
#   - Specific IP: http://192.168.4.247:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Enable dynamic CORS that automatically accepts origins matching server IP addresses
# Set to false to use only CORS_ORIGINS (standard CORS behavior)
ENABLE_DYNAMIC_CORS=true

# Client/frontend port for generating dynamic CORS origins
# This should match CLIENT_PORT above
# CLIENT_PORT=5173

# -------------------------------------------
# LOGGING
# -------------------------------------------
# Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Format: text, json
LOG_FORMAT=text
# Optional log file path
LOG_FILE=

# -------------------------------------------
# MONITORING (Optional)
# -------------------------------------------
# Sentry DSN for error tracking
SENTRY_DSN=
# Enable Prometheus metrics endpoint
PROMETHEUS_ENABLED=true

# -------------------------------------------
# AI INTEGRATION
# -------------------------------------------
# OpenAI (Optional - for standard OpenAI API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Azure OpenAI (Optional - for Azure-hosted OpenAI)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_MODEL_NAME=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure OpenAI Embeddings (Optional)
AZURE_OPENAI_EMBEDDING_MODEL=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-12-01-preview

# Azure Anthropic (Optional - for Azure-hosted Claude)
AZURE_ANTHROPIC_ENDPOINT=
AZURE_ANTHROPIC_API_KEY=
AZURE_ANTHROPIC_DEPLOYMENT_NAME=

# -------------------------------------------
# RATE LIMITING
# -------------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# -------------------------------------------
# FILE UPLOAD
# -------------------------------------------
# Max upload size in bytes (default: 10MB)
MAX_UPLOAD_SIZE=10485760

# -------------------------------------------
# FEATURE FLAGS
# -------------------------------------------
ENABLE_AI_FEATURES=true
ENABLE_WEBSOCKETS=true
ENABLE_METRICS=true
