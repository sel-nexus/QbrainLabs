    {
      "id": "general-change-readiness",
      "name": "General - Change Readiness Assessment",
      "description": "Assess organizational readiness for change initiatives",
      "industry": "general",
      "category": "readiness",
      "tags": ["change", "readiness", "transformation", "assessment"],
      "questions": [
        {
          "text": "How would you describe your organization's attitude toward change?",
          "type": "multiple_choice",
          "required": true,
          "options": ["Resistant to change", "Cautious about change", "Neutral", "Open to change", "Embraces change"]
        },
        {
          "text": "Rate your agreement with the following statements:",
          "type": "likert",
          "required": true,
          "config": {
            "scale": 5,
            "labels": ["Strongly Disagree", "Disagree", "Neutral", "Agree", "Strongly Agree"],
            "statements": [
              "Leadership supports this change initiative",
              "Employees understand why change is needed",
              "Resources are available to support the change",
              "Communication about the change is clear",
              "Training will be provided for new processes"
            ]
          }
        },
        {
          "text": "What are the biggest barriers to successful change?",
          "type": "multiple_select",
          "required": true,
          "options": ["Lack of leadership support", "Insufficient resources", "Employee resistance", "Unclear communication", "Competing priorities", "Technical challenges", "Cultural barriers"]
        },
        {
          "text": "What would help you embrace this change more effectively?",
          "type": "textarea",
          "required": false,
          "config": {"max_length": 600}
        }
      ]
    },
    {
      "id": "general-roi-estimation",
      "name": "General - ROI Estimation Survey",
      "description": "Gather data to estimate return on investment for initiatives",
      "industry": "general",
      "category": "roi",
      "tags": ["roi", "value", "estimation", "business case"],
      "questions": [
        {
          "text": "How much time do you currently spend on the process/task being improved?",
          "type": "multiple_choice",
          "required": true,
          "options": ["Less than 1 hour/week", "1-5 hours/week", "5-10 hours/week", "10-20 hours/week", "More than 20 hours/week"]
        },
        {
          "text": "What percentage of time savings do you expect from this initiative?",
          "type": "rating",
          "required": true,
          "config": {"scale": 5, "labels": ["0-20%", "20-40%", "40-60%", "60-80%", "80-100%"]}
        },
        {
          "text": "Which benefits do you expect from this initiative?",
          "type": "multiple_select",
          "required": true,
          "options": ["Cost reduction", "Time savings", "Quality improvement", "Risk reduction", "Revenue increase", "Customer satisfaction", "Employee satisfaction", "Compliance improvement"]
        },
        {
          "text": "Estimate the annual cost of the current process/problem:",
          "type": "multiple_choice",
          "required": false,
          "options": ["Less than $10,000", "$10,000 - $50,000", "$50,000 - $100,000", "$100,000 - $500,000", "More than $500,000", "Unknown"]
        },
        {
          "text": "Please describe any additional value or benefits you anticipate:",
          "type": "textarea",
          "required": false,
          "config": {"max_length": 500}
        }
      ]
    }
  ]
