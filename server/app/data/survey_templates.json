{
  "templates": [
    {
      "id": "healthcare-patient-experience",
      "name": "Healthcare - Patient Experience Survey",
      "description": "Assess patient satisfaction and identify areas for improvement in healthcare delivery",
      "industry": "healthcare",
      "category": "post_workshop",
      "tags": ["patient", "satisfaction", "healthcare", "quality"],
      "questions": [
        {
          "text": "How would you rate your overall experience with our healthcare services?",
          "type": "rating",
          "required": true,
          "config": {"scale": 5, "labels": ["Very Poor", "Poor", "Average", "Good", "Excellent"]}
        },
        {
          "text": "Which aspects of care were most important to you?",
          "type": "multiple_select",
          "required": true,
          "options": ["Wait times", "Staff friendliness", "Communication", "Treatment effectiveness", "Facility cleanliness", "Follow-up care"]
        },
        {
          "text": "How likely are you to recommend our services to others?",
          "type": "rating",
          "required": true,
          "config": {"scale": 10, "labels": ["Not at all likely", "", "", "", "", "", "", "", "", "Extremely likely"]}
        },
        {
          "text": "What could we do to improve your experience?",
          "type": "textarea",
          "required": false,
          "config": {"max_length": 1000}
        }
      ]
    },
    {
      "id": "healthcare-clinical-workflow",
      "name": "Healthcare - Clinical Workflow Assessment",
      "description": "Evaluate clinical workflow efficiency and identify bottlenecks",
      "industry": "healthcare",
      "category": "pre_workshop",
      "tags": ["clinical", "workflow", "efficiency", "process"],
      "questions": [
        {
          "text": "How would you rate the efficiency of current clinical workflows?",
          "type": "rating",
          "required": true,
          "config": {"scale": 5, "labels": ["Very Inefficient", "Inefficient", "Neutral", "Efficient", "Very Efficient"]}
        },
        {
          "text": "Which processes cause the most delays in patient care?",
          "type": "multiple_select",
          "required": true,
          "options": ["Patient intake", "Documentation", "Lab results", "Medication dispensing", "Discharge process", "Insurance verification", "Specialist referrals"]
        },
        {
          "text": "Please rate the following statements about your workflow:",
          "type": "likert",
          "required": true,
          "config": {
            "scale": 5,
            "labels": ["Strongly Disagree", "Disagree", "Neutral", "Agree", "Strongly Agree"],
            "statements": [
              "I have access to all information needed for patient care",
              "Communication between departments is effective",
              "Technology supports rather than hinders my work",
              "I can complete documentation in a timely manner"
            ]
          }
        },
        {
          "text": "What is the biggest challenge you face in your daily workflow?",
          "type": "textarea",
          "required": true,
          "config": {"max_length": 500}
        }
      ]
    },
    {
      "id": "finance-risk-assessment",
      "name": "Finance - Risk Assessment Survey",
      "description": "Evaluate organizational risk awareness and management practices",
      "industry": "finance",
      "category": "validation",
      "tags": ["risk", "compliance", "finance", "assessment"],
      "questions": [
        {
          "text": "How confident are you in your organization's risk management framework?",
          "type": "rating",
          "required": true,
          "config": {"scale": 5, "labels": ["Not Confident", "Slightly Confident", "Moderately Confident", "Very Confident", "Extremely Confident"]}
        },
        {
          "text": "Which risk categories are most relevant to your operations?",
          "type": "multiple_select",
          "required": true,
          "options": ["Credit risk", "Market risk", "Operational risk", "Compliance risk", "Cybersecurity risk", "Liquidity risk", "Reputational risk"]
        },
        {
          "text": "How frequently does your team review risk assessments?",
          "type": "multiple_choice",
          "required": true,
          "options": ["Daily", "Weekly", "Monthly", "Quarterly", "Annually", "Rarely/Never"]
        },
        {
          "text": "What emerging risks concern you most?",
          "type": "textarea",
          "required": false,
          "config": {"max_length": 800}
        }
      ]
    },
    {
      "id": "finance-compliance-readiness",
